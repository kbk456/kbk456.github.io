#!/bin/bash

# 블로그 관리 CLI 스크립트
# 사용법: ./blog [명령어] [옵션]

BLOG_DIR="$(cd "$(dirname "$0")" && pwd)"
POSTS_DIR="$BLOG_DIR/_posts"

# 색상 정의
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# 도움말 출력
show_help() {
    echo ""
    echo -e "${BLUE}블로그 관리 CLI${NC}"
    echo ""
    echo "사용법: ./blog [명령어]"
    echo ""
    echo "명령어:"
    echo "  new, n      새 글 작성"
    echo "  list, l     글 목록 보기"
    echo "  edit, e     글 수정"
    echo "  delete, d   글 삭제"
    echo "  publish, p  GitHub에 푸시"
    echo "  help, h     도움말 보기"
    echo ""
}

# 새 글 작성
new_post() {
    echo ""
    echo -e "${GREEN}=== 새 글 작성 ===${NC}"
    echo ""

    # 제목 입력
    read -p "글 제목: " title
    if [ -z "$title" ]; then
        echo -e "${RED}제목을 입력해주세요.${NC}"
        exit 1
    fi

    # 카테고리 입력
    read -p "카테고리 (기본: 일반): " category
    category=${category:-일반}

    # 파일명 생성 (한글 제목을 영문으로 변환하거나 그대로 사용)
    date=$(date +%Y-%m-%d)
    # 제목에서 공백을 하이픈으로, 특수문자 제거
    filename=$(echo "$title" | tr ' ' '-' | tr -cd '[:alnum:]-_가-힣')
    filepath="$POSTS_DIR/${date}-${filename}.md"

    # 파일 생성
    cat > "$filepath" << EOF
---
layout: default
title: "$title"
date: $date
categories: [$category]
---

# $title

여기에 내용을 작성하세요.

EOF

    echo ""
    echo -e "${GREEN}글이 생성되었습니다: ${filepath}${NC}"
    echo ""

    # 에디터로 열기
    read -p "에디터로 열까요? (y/n): " open_editor
    if [ "$open_editor" = "y" ] || [ "$open_editor" = "Y" ]; then
        if command -v code &> /dev/null; then
            code "$filepath"
        elif command -v vim &> /dev/null; then
            vim "$filepath"
        else
            open "$filepath"
        fi
    fi
}

# 글 목록 보기
list_posts() {
    echo ""
    echo -e "${BLUE}=== 글 목록 ===${NC}"
    echo ""

    if [ ! -d "$POSTS_DIR" ] || [ -z "$(ls -A $POSTS_DIR 2>/dev/null)" ]; then
        echo "등록된 글이 없습니다."
        return
    fi

    i=1
    for file in $(ls -r "$POSTS_DIR"/*.md 2>/dev/null); do
        filename=$(basename "$file")
        # 파일에서 title 추출
        title=$(grep -m 1 "^title:" "$file" | sed 's/title: *"\?\([^"]*\)"\?/\1/')
        date=$(echo "$filename" | grep -oE "^[0-9]{4}-[0-9]{2}-[0-9]{2}")
        echo -e "  ${YELLOW}[$i]${NC} $date - $title"
        ((i++))
    done
    echo ""
}

# 글 수정
edit_post() {
    list_posts

    if [ ! -d "$POSTS_DIR" ] || [ -z "$(ls -A $POSTS_DIR 2>/dev/null)" ]; then
        return
    fi

    read -p "수정할 글 번호: " num

    files=($(ls -r "$POSTS_DIR"/*.md 2>/dev/null))
    if [ "$num" -gt 0 ] && [ "$num" -le "${#files[@]}" ]; then
        filepath="${files[$((num-1))]}"
        echo ""
        echo -e "${GREEN}에디터로 여는 중: $filepath${NC}"

        if command -v code &> /dev/null; then
            code "$filepath"
        elif command -v vim &> /dev/null; then
            vim "$filepath"
        else
            open "$filepath"
        fi
    else
        echo -e "${RED}잘못된 번호입니다.${NC}"
    fi
}

# 글 삭제
delete_post() {
    list_posts

    if [ ! -d "$POSTS_DIR" ] || [ -z "$(ls -A $POSTS_DIR 2>/dev/null)" ]; then
        return
    fi

    read -p "삭제할 글 번호: " num

    files=($(ls -r "$POSTS_DIR"/*.md 2>/dev/null))
    if [ "$num" -gt 0 ] && [ "$num" -le "${#files[@]}" ]; then
        filepath="${files[$((num-1))]}"
        filename=$(basename "$filepath")

        echo ""
        read -p "정말 '$filename' 을(를) 삭제하시겠습니까? (y/n): " confirm
        if [ "$confirm" = "y" ] || [ "$confirm" = "Y" ]; then
            rm "$filepath"
            echo -e "${GREEN}삭제되었습니다.${NC}"
        else
            echo "취소되었습니다."
        fi
    else
        echo -e "${RED}잘못된 번호입니다.${NC}"
    fi
}

# GitHub에 푸시
publish() {
    echo ""
    echo -e "${BLUE}=== GitHub에 발행 ===${NC}"
    echo ""

    cd "$BLOG_DIR"

    # 변경사항 확인
    if [ -z "$(git status --porcelain)" ]; then
        echo "변경사항이 없습니다."
        return
    fi

    # 변경사항 표시
    echo "변경된 파일:"
    git status --short
    echo ""

    read -p "커밋 메시지 (기본: 블로그 업데이트): " message
    message=${message:-블로그 업데이트}

    git add -A
    git commit -m "$message"
    git push

    echo ""
    echo -e "${GREEN}발행 완료! 1-2분 후 https://kbk456.github.io 에서 확인하세요.${NC}"
    echo ""
}

# 메인 로직
case "$1" in
    new|n)
        new_post
        ;;
    list|l)
        list_posts
        ;;
    edit|e)
        edit_post
        ;;
    delete|d)
        delete_post
        ;;
    publish|p)
        publish
        ;;
    help|h|"")
        show_help
        ;;
    *)
        echo -e "${RED}알 수 없는 명령어: $1${NC}"
        show_help
        exit 1
        ;;
esac
